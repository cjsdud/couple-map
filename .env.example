# Vercel 프로젝트 환경변수에도 동일하게 설정할 것
# ⚠️ .ait(앱인토스 번들)는 로컬에서 빌드되므로, 여기 값이 비면 그 기능이 빠진 채 패키징된다.
#    실제로 VITE_KAKAO_JS_KEY 누락으로 미니앱에서 실지도가 동작하지 않은 사례 있음 (2026-07-25).
# Supabase 프로젝트 → Settings → API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Kakao Developers → 내 애플리케이션 → 앱 키
VITE_KAKAO_REST_KEY=xxxxxxxx
# 실지도 모드(Kakao Maps SDK)용 — 플랫폼(Web) 사이트 도메인에 실행 Origin 등록 필요
VITE_KAKAO_JS_KEY=xxxxxxxx
